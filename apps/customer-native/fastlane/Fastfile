default_platform(:ios)

# This Fastfile is a scaffold (see native-apps plan, Phase A step 7) - it will
# not run successfully until:
#   1. The Apple Developer Program membership exists (user is enrolling).
#   2. An App Store Connect API key is generated (App Store Connect -> Users
#      and Access -> Integrations -> Keys) and its .p8/Issuer ID/Key ID are
#      stored as GitHub secrets (APP_STORE_CONNECT_KEY_ID, _ISSUER_ID, _KEY).
#   3. A private git repo for `fastlane match` exists and MATCH_GIT_URL +
#      MATCH_PASSWORD secrets are set - see https://docs.fastlane.tools/actions/match/
#   4. The app record itself exists in App Store Connect (bundle id
#      app.kaffeekarte.customer) - `fastlane produce` can create this once
#      the Apple Developer account is ready.
# None of this can be filled in without a real Apple Developer account, so
# it's intentionally left as TODOs rather than guessed-at values.

platform :ios do
  desc "Fetch/create the Distribution certificate + provisioning profile via match"
  lane :certificates do
    # There is no local Mac in this project, so CI is the only place the
    # distribution certificate can ever be created - readonly must stay
    # false here (match is idempotent: it only creates a new cert/profile
    # when none exists yet, otherwise it just reuses what's in the repo).
    setup_ci if is_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      # TEMPORARY: force a fresh provisioning profile so it picks up the
      # Associated Domains capability just added to the App ID. Revert to
      # false once a build with the new profile has succeeded once.
      force: true,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )
  end

  desc "Build the .ipa (release, TestFlight-bound)"
  lane :build do
    certificates
    # CURRENT_PROJECT_VERSION is a static "1" in the checked-in project -
    # TestFlight rejects re-uploads with a build number it's already seen.
    # GITHUB_RUN_NUMBER alone isn't safe: re-running a workflow reuses the
    # exact same run number, which caused a duplicate-build-number upload
    # rejection. Ask App Store Connect what it last saw instead.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.kaffeekarte.customer",
    )
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: (latest_build_number + 1).to_s,
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["FASTLANE_TEAM_ID"] || "P7633QY6QK",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["app.kaffeekarte.customer"],
      bundle_identifier: "app.kaffeekarte.customer",
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
    )
  end

  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :android do
  # Scaffold (see native-apps plan, Phase A step 8) - needs:
  #   1. An upload keystore (generate once, base64 it into ANDROID_KEYSTORE_BASE64
  #      + ANDROID_KEYSTORE_PASSWORD/_KEY_ALIAS/_KEY_PASSWORD secrets).
  #   2. Google Play App Signing enrolled for this app (Google holds the real
  #      signing key; this upload key only needs to be safely rotatable).
  #   3. A Play Console service-account JSON key with API access, stored as
  #      the PLAY_JSON_KEY secret, for fastlane `supply` to authenticate.
  #   4. The app already created once in Play Console (supply cannot create
  #      the app listing itself, only upload builds to an existing one).
  desc "Build and upload to the Play Console internal testing track"
  lane :beta do
    # The versionCode checked into build.gradle needed a manual bump every
    # time (see git history) because Play rejects re-uploading a versionCode
    # it's already seen, same problem the iOS lane's build-number handling
    # above solves. Ask Play what it last saw instead, across every track a
    # version code could have landed on (version codes are reserved
    # package-wide, not per track), and write the next one into build.gradle
    # below before building.
    existing_version_codes = ["internal", "alpha", "beta", "production"].flat_map do |track|
      begin
        google_play_track_version_codes(
          package_name: "app.kaffeekarte.customer",
          track: track,
          json_key: ENV["PLAY_JSON_KEY_PATH"],
        )
      rescue StandardError
        []
      end
    end
    version_code = (existing_version_codes.max || 0) + 1

    signing_properties = {
      "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
      "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
      "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
      "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      # The upload keystore was generated as PKCS12 (openssl, no local
      # keytool available) and saved with a .jks extension by the decode
      # step in the workflow - explicit here so AGP doesn't guess wrong
      # based on the extension.
      "android.injected.signing.store.type" => "PKCS12",
    }

    # Play burns a versionCode the moment an upload attempt submits it, even
    # if that attempt then fails or the edit is abandoned - so a number that
    # google_play_track_version_codes above never saw on any committed track
    # can still come back "already been used" (hit this exact case after a
    # couple of failed CI runs). Retry forward on that specific error instead
    # of just picking one number and hoping.
    #
    # versionCode is written into build.gradle itself (see below) rather
    # than passed as an android.injected.version.code gradle property -
    # confirmed by CI logs that the injected-property override is silently
    # ignored by this project's bundleRelease task (every retry kept
    # uploading a bundle still stamped with the old versionCode, even after
    # forcing real rebuilds with --rerun-tasks). Rewriting the file is a
    # real input change, so Gradle can't fail to notice it.
    max_attempts = 5
    attempt = 1
    begin
      UI.message("Using versionCode #{version_code} (attempt #{attempt}/#{max_attempts})")
      # No fastlane action for this is actually built in (verified the hard
      # way: android_set_version_code doesn't exist at all, and
      # increment_version_code turned out to only exist as a third-party
      # plugin this project doesn't have installed - no Gemfile/Pluginfile
      # here). Plain Ruby file edit instead, so it doesn't depend on any
      # action name being right.
      # Dir.pwd here is actually .../customer-native/fastlane (fastlane's
      # own directory handling - it chdirs into the fastlane/ folder before
      # running lane code, confirmed by CI erroring on a path with an extra
      # /fastlane/ segment). __dir__ is that same fastlane/ folder too, so
      # go up one level to reach the project root the gradle() calls below
      # use as project_dir: "android".
      gradle_file_path = File.expand_path("../android/app/build.gradle", __dir__)
      gradle_file_contents = File.read(gradle_file_path)
      updated_contents = gradle_file_contents.sub(
        /versionCode\s+\d+/,
        "versionCode #{version_code}",
      )
      if updated_contents == gradle_file_contents
        UI.user_error!("Could not find a versionCode line to replace in #{gradle_file_path}")
      end
      File.write(gradle_file_path, updated_contents)
      gradle(
        task: "bundle",
        build_type: "Release",
        project_dir: "android",
        properties: signing_properties,
      )
      upload_to_play_store(
        package_name: "app.kaffeekarte.customer",
        track: "internal",
        json_key: ENV["PLAY_JSON_KEY_PATH"],
        aab: "android/app/build/outputs/bundle/release/app-release.aab",
      )
    rescue StandardError => e
      if attempt < max_attempts && e.message.to_s.include?("has already been used")
        attempt += 1
        version_code += 1
        retry
      end
      raise
    end

    # Play Console's internal testing track needs testers whose devices meet
    # its own tester requirements - unrelated to the app's actual
    # minSdkVersion (23 = Android 6.0, see variables.gradle). A signed .apk
    # sideloads directly onto any device that satisfies that minSdkVersion,
    # bypassing Play Console testing entirely. .aab alone can't be
    # installed directly (needs Play Store's bundletool), hence this
    # separate "assemble" build alongside "bundle" above.
    # build.gradle already has the versionCode from whichever attempt
    # succeeded above (written directly into the file), so the sideload
    # .apk and the Play-uploaded .aab agree without passing it again here.
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "android",
      properties: signing_properties,
    )
  end
end
