default_platform(:ios)

# This Fastfile is a scaffold (see native-apps plan, Phase A step 7) - it will
# not run successfully until:
#   1. The Apple Developer Program membership exists (user is enrolling).
#   2. An App Store Connect API key is generated (App Store Connect -> Users
#      and Access -> Integrations -> Keys) and its .p8/Issuer ID/Key ID are
#      stored as GitHub secrets (APP_STORE_CONNECT_KEY_ID, _ISSUER_ID, _KEY).
#   3. A private git repo for `fastlane match` exists and MATCH_GIT_URL +
#      MATCH_PASSWORD secrets are set - see https://docs.fastlane.tools/actions/match/
#   4. The app record itself exists in App Store Connect (bundle id
#      app.kaffeekarte.customer) - `fastlane produce` can create this once
#      the Apple Developer account is ready.
# None of this can be filled in without a real Apple Developer account, so
# it's intentionally left as TODOs rather than guessed-at values.

platform :ios do
  desc "Fetch/create the Distribution certificate + provisioning profile via match"
  lane :certificates do
    # There is no local Mac in this project, so CI is the only place the
    # distribution certificate can ever be created - readonly must stay
    # false here (match is idempotent: it only creates a new cert/profile
    # when none exists yet, otherwise it just reuses what's in the repo).
    setup_ci if is_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      # TEMPORARY: force a fresh provisioning profile so it picks up the
      # Associated Domains capability just added to the App ID. Revert to
      # false once a build with the new profile has succeeded once.
      force: true,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )
  end

  desc "Build the .ipa (release, TestFlight-bound)"
  lane :build do
    certificates
    # CURRENT_PROJECT_VERSION is a static "1" in the checked-in project -
    # TestFlight rejects re-uploads with a build number it's already seen.
    # GITHUB_RUN_NUMBER alone isn't safe: re-running a workflow reuses the
    # exact same run number, which caused a duplicate-build-number upload
    # rejection. Ask App Store Connect what it last saw instead.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.kaffeekarte.customer",
    )
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: (latest_build_number + 1).to_s,
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["FASTLANE_TEAM_ID"] || "P7633QY6QK",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["app.kaffeekarte.customer"],
      bundle_identifier: "app.kaffeekarte.customer",
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
    )
  end

  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end

platform :android do
  # Scaffold (see native-apps plan, Phase A step 8) - needs:
  #   1. An upload keystore (generate once, base64 it into ANDROID_KEYSTORE_BASE64
  #      + ANDROID_KEYSTORE_PASSWORD/_KEY_ALIAS/_KEY_PASSWORD secrets).
  #   2. Google Play App Signing enrolled for this app (Google holds the real
  #      signing key; this upload key only needs to be safely rotatable).
  #   3. A Play Console service-account JSON key with API access, stored as
  #      the PLAY_JSON_KEY secret, for fastlane `supply` to authenticate.
  #   4. The app already created once in Play Console (supply cannot create
  #      the app listing itself, only upload builds to an existing one).
  desc "Build and upload to the Play Console internal testing track"
  lane :beta do
    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      },
    )
    upload_to_play_store(
      track: "internal",
      json_key: ENV["PLAY_JSON_KEY_PATH"],
      aab: "android/app/build/outputs/bundle/release/app-release.aab",
    )
    # Play Console's internal testing track needs testers whose devices meet
    # its own tester requirements - unrelated to the app's actual
    # minSdkVersion (23 = Android 6.0, see variables.gradle). A signed .apk
    # sideloads directly onto any device that satisfies that minSdkVersion,
    # bypassing Play Console testing entirely. .aab alone can't be
    # installed directly (needs Play Store's bundletool), hence this
    # separate "assemble" build alongside "bundle" above.
    gradle(
      task: "assemble",
      build_type: "Release",
      project_dir: "android",
      properties: {
        "android.injected.signing.store.file" => ENV["ANDROID_KEYSTORE_PATH"],
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"],
      },
    )
  end
end
