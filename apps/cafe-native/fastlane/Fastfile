default_platform(:ios)

# Same recipe as apps/customer-native/fastlane/Fastfile (proven working there
# via TestFlight) - see that file's comments for the fuller rationale behind
# each step. This app needs no OAuth plugin (barista login is plain
# email/password, no Google/Apple sign-in) and no Associated Domains
# capability (no deep links), so it's simpler than the customer app's Fastfile.

platform :ios do
  desc "Fetch/create the Distribution certificate + provisioning profile via match"
  lane :certificates do
    # There is no local Mac in this project, so CI is the only place the
    # distribution certificate can ever be created - readonly must stay
    # false here (match is idempotent: it only creates a new cert/profile
    # when none exists yet, otherwise it just reuses what's in the repo).
    # Same match git repo as apps/customer-native - match keys profiles by
    # bundle id, so a second app's profile living in the same repo is normal.
    setup_ci if is_ci
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )
  end

  desc "Build the .ipa (release, TestFlight-bound)"
  lane :build do
    certificates
    # CURRENT_PROJECT_VERSION is a static "1" in the checked-in project -
    # TestFlight rejects re-uploads with a build number it's already seen.
    # GITHUB_RUN_NUMBER alone isn't safe: re-running a workflow reuses the
    # exact same run number, which caused a duplicate-build-number upload
    # rejection on the customer app. Ask App Store Connect what it last saw
    # instead.
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.kaffeekarte.cafe",
    )
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: (latest_build_number + 1).to_s,
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: ENV["FASTLANE_TEAM_ID"] || "P7633QY6QK",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]["app.kaffeekarte.cafe"],
      bundle_identifier: "app.kaffeekarte.cafe",
    )
    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
    )
  end

  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      is_key_content_base64: true,
    )
    build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
