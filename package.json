{
  "name": "digistamp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "contracts",
    "packages/*",
    "infra/*"
  ],
  "scripts": {
    "prepare": "echo \"Monorepo ready\"",
    "lint": "echo \"(todo) run repo-wide linters\"",
    "dev": "node api/server.cjs",
    "chain": "hardhat node",
    "deploy": "hardhat run scripts/deploy.cjs --network localhost",
    "dev:api": "tsx watch api/server.ts",
    "api": "tsx api/server.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "chai": "^4.5.0",
    "hardhat": "^2.26.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "fastify": "^5.6.1",
    "viem": "^2.38.6",
    "zod": "^4.1.12"
  }
}
