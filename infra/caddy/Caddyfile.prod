{$PROD_DOMAIN} {
  encode zstd gzip

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
  }

  @adminUi path /admin-dashboard.html
  handle @adminUi {
    basic_auth {
      {$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
    }
    reverse_proxy apps:8080
  }

  @adminCafeDesign path /admin-cafe-design.html
  handle @adminCafeDesign {
    basic_auth {
      {$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
    }
    reverse_proxy apps:8080
  }

  @adminLogoPreview path /admin-logo-preview.html
  handle @adminLogoPreview {
    basic_auth {
      {$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
    }
    reverse_proxy apps:8080
  }

  # Called by a scheduled GitHub Actions workflow (no interactive user, so no
  # basic-auth password available to it) - protected by requireAdminKey on
  # the Node side instead, via the x-admin-key header the caller sends
  # itself. Must come before the general @adminApi matcher below, which
  # would otherwise both demand basic_auth and overwrite x-admin-key.
  @adminOnboardingReminders path /api/admin/customers/onboarding-reminders
  handle @adminOnboardingReminders {
    reverse_proxy apps:8080
  }

  @adminApi path /api/admin/*
  handle @adminApi {
    basic_auth {
      {$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
    }
    reverse_proxy apps:8080 {
      header_up x-admin-key {$ADMIN_TOKEN}
    }
  }

  handle {
    reverse_proxy apps:8080
  }
}
