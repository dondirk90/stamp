# Staging (SQLite) — minimal
# Copy to repo root as .env.staging and adjust.

# Public port for the Apps server on the VPS
STAGING_APPS_PORT=8081

# Used for links in emails (if enabled). For no-domain setups, keep IP:PORT.
STAGING_APPS_BASE_URL=http://<SERVER_IP>:8081

# Used by the staging reverse proxy for HTTPS.
STAGING_DOMAIN=staging.example.com

# Optional SMTP (leave empty to log emails instead)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=info@kaffeekarte.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=

# Sign in with Apple - not usable until the Services ID + "Sign In with
# Apple" key exist in Apple Developer (see native-apps plan).
# APPLE_PRIVATE_KEY_BASE64 is the .p8 file contents, base64-encoded onto a
# single line (a raw multi-line PEM does not survive docker-compose's
# env-file format intact). Encode with:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=

# Google Wallet (Android loyalty cards) - not usable until an Issuer account
# exists in the Google Wallet Business Console (pay.google.com/business/console)
# and a dedicated service account (role: linked as a user in that console,
# not a GCP IAM role) has been created for it.
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64 is the downloaded service-account
# JSON key file, base64-encoded onto a single line:
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_BASE64=

# Optional admin protection for /admin-dashboard.html and /api/admin/*
# Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'
# Escape each "$" as "$$" inside .env files.
ADMIN_TOKEN=
ADMIN_BASIC_USER=admin
ADMIN_BASIC_HASH=
