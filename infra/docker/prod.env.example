# Prod (Postgres) — minimal
# Copy to repo root as .env.prod and adjust.

# Public port for the Apps server on the VPS
PROD_APPS_PORT=8080

# Used for links in emails (if enabled). For no-domain setups, keep IP:PORT.
PROD_APPS_BASE_URL=http://<SERVER_IP>:8080

# Used by the production reverse proxy for HTTPS.
PROD_DOMAIN=app.example.com

# Postgres credentials (internal to docker network)
POSTGRES_USER=stempel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stempel

# IMPORTANT: host must be 'db' (docker service name), not 127.0.0.1
DATABASE_URL=postgres://stempel:change-me@db:5432/stempel

# Optional SMTP (leave empty to log emails instead)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=info@kaffeekarte.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_STATE_SECRET=

# Sign in with Apple - not usable until the Services ID + "Sign In with
# Apple" key exist in Apple Developer (see native-apps plan). APPLE_PRIVATE_KEY
# is the .p8 file contents; keep its newlines literal (or escape as \n).
APPLE_TEAM_ID=
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional admin protection for /admin-dashboard.html and /api/admin/*
# Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'
# Escape each "$" as "$$" inside .env files.
ADMIN_TOKEN=
ADMIN_BASIC_USER=admin
ADMIN_BASIC_HASH=
